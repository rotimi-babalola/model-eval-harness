# Shared fallbacks for openai-protocol models
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Shared fallback for anthropic-protocol models
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Model A (OpenAI-compatible by default)
MODEL_A=gpt-4o-mini
MODEL_A_LABEL=gpt-4o-mini
MODEL_A_PROTOCOL=openai
# MODEL_A_BASE_URL=https://openrouter.ai/api/v1
# MODEL_A_API_KEY=sk-or-...
MODEL_A_INPUT_PRICE=0.15
MODEL_A_OUTPUT_PRICE=0.60

# Model B (switch to anthropic for the native Messages API)
MODEL_B=gpt-4o
MODEL_B_LABEL=gpt-4o
MODEL_B_PROTOCOL=openai
# MODEL_B_BASE_URL=https://api.anthropic.com/v1
# MODEL_B_API_KEY=sk-ant-...
MODEL_B_INPUT_PRICE=2.50
MODEL_B_OUTPUT_PRICE=10.00

# MAX_STEPS=8
